# Receipts — .gitignore
#
# NOTE: .kiro/ is intentionally NOT ignored. The specs, steering, and hooks
# are part of our submission — judges should see how we used Kiro.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/

# Dependencies (we don't use npm, but just in case)
node_modules/

# Netlify local state
.netlify/

# REAL PERSONAL HEALTH DATA — never commit.
# Put your own exports in sample-data/. These patterns block them anywhere.
sample-data/
apple_health_export/
export.xml
export_cda.xml
export.zip
*.export.xml
*whoop*.csv
*oura*.csv
*fitbit*.csv
